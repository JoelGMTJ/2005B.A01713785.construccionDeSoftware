<script>
    const buscar = document.getElementById("buscar");
    buscar.onkeyup = () => {
        console.log(buscar.value);
    }
    fetch(`/museum/buscar/${buscar.value}`, {
            method: 'GET',
        }).then((result) => {
            return result.json();
        }).then((data) => {
            console.log("Hola, el codigo si ha llegado hasta aqui")
            console.log(data);
        }).catch((error) => {
            console.log(error);
        }); 
</script>