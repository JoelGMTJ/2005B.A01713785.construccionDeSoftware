<script>
    const buscar = document.getElementById("buscar");
    buscar.onkeyup = () => {
        const searchValue = buscar.value;
        console.log(searchValue);
        
        fetch(`/museum/buscar/${searchValue}`, {
            method: 'GET',
        }).then((result) => {
            return result.json();
        }).then((data) => {
            console.log(data);
            let html = '';
            
            if (data.momentos.length == 0) {
                html = `No hay momentos registrados`;
            }
            else {
                for (let i = 0; i < data.momentos.length; i++) {
                    html += `
                        <div class="column is-3">
                            <div style="font-weight: bold;">
                                ${data.momentos[i].name}
                            </div>
                            <a href="${data.momentos[i].videoLink}" target="_blank">
                                <figure class="image is-16by9">
                                    <img src="${data.momentos[i].image}">
                                </figure>
                            </a>
                            <a class="button is-warning is-small mt-2" href="/museum/${data.momentos[i].momentoId}/edit">
                                <span class="icon">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </span>
                                <span>Editar</span>
                            </a>
                        </div>
                    `;
                }
            }
            
            document.getElementById('topColumn').innerHTML = html;
        }).catch((error) => {
            console.log(error);
        }); 
    }
</script>